/target
**/*.rs.bk
*.pdb

# Benchmark and corpus output. These are large, machine specific, and regenerable.
/bench-results
/corpus-out
perf.data
perf.data.old
*.profraw
*.profdata

# IR dumps. -fdump-ir= writes these into whatever directory it was run from, and they are named
# after the pass they bracket. The golden files under tests/golden are not named this way.
*-before-*.ir
*-after-*.ir

# Editor and OS noise
.DS_Store
.idea/
.vscode/
*.swp
