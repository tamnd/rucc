;; Or'ing.

(rule (simplify (or.i8 (iconst.i8 k) (value.i8 x)))
      (or.i8 (value.i8 x) (iconst.i8 k))
      (spec (= (bvor k x) (result))))

(rule (simplify (or.i16 (iconst.i16 k) (value.i16 x)))
