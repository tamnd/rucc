(rule (simplify (icmp_sgt.i1 (iconst.i8 k) (value.i8 x)))
      (icmp_slt.i1 (value.i8 x) (iconst.i8 k))
      (spec (= (ite (bvsgt k x) 1 0) (result))))

(rule (simplify (icmp_sgt.i1 (iconst.i16 k) (value.i16 x)))
