;; Exclusive or'ing.

(rule (simplify (xor.i8 (iconst.i8 k) (value.i8 x)))
      (xor.i8 (value.i8 x) (iconst.i8 k))
      (spec (= (bvxor k x) (result))))

(rule (simplify (xor.i16 (iconst.i16 k) (value.i16 x)))
      (xor.i16 (value.i16 x) (iconst.i16 k))
      (spec (= (bvxor k x) (result))))

(rule (simplify (xor.i32 (iconst.i32 k) (value.i32 x)))
      (xor.i32 (value.i32 x) (iconst.i32 k))
      (spec (= (bvxor k x) (result))))

(rule (simplify (xor.i64 (iconst.i64 k) (value.i64 x)))
      (xor.i64 (value.i64 x) (iconst.i64 k))
      (spec (= (bvxor k x) (result))))

;; Comparing.
;;
;; A comparison is not commutative, so the constant does not just change sides: the predicate turns
;; round with it. `0 < x` is `x > 0`, `k >= x` unsigned is `x <= k` unsigned, and `eq` and `ne` are
;; the two that stay what they were. Nothing else in the rules is written against a comparison
;; with its constant on the left, every rule in `compare.rules` has it on the right, so until this
;; fires none of those can.
;;
;; It is also what the code generator wants. `0 < n` is the guard header copying puts in front of
;; a loop that counts up from zero, and on x86-64 a constant on the left is a register zeroed to
;; hold it and a compare of two registers, where `n > 0` is a test of the one register against
;; itself. The `spec` clause reads the predicate the way `ir.model` does, so each of these is a
;; claim about the solver's own orderings and the predicate on the right is checked rather than
;; trusted.

(rule (simplify (icmp_eq.i1 (iconst.i8 k) (value.i8 x)))
      (icmp_eq.i1 (value.i8 x) (iconst.i8 k))
      (spec (= (ite (= k x) 1 0) (result))))

(rule (simplify (icmp_eq.i1 (iconst.i16 k) (value.i16 x)))
      (icmp_eq.i1 (value.i16 x) (iconst.i16 k))
      (spec (= (ite (= k x) 1 0) (result))))

(rule (simplify (icmp_eq.i1 (iconst.i32 k) (value.i32 x)))
      (icmp_eq.i1 (value.i32 x) (iconst.i32 k))
      (spec (= (ite (= k x) 1 0) (result))))

(rule (simplify (icmp_eq.i1 (iconst.i64 k) (value.i64 x)))
      (icmp_eq.i1 (value.i64 x) (iconst.i64 k))
      (spec (= (ite (= k x) 1 0) (result))))

(rule (simplify (icmp_ne.i1 (iconst.i8 k) (value.i8 x)))
      (icmp_ne.i1 (value.i8 x) (iconst.i8 k))
      (spec (= (ite (not (= k x)) 1 0) (result))))

(rule (simplify (icmp_ne.i1 (iconst.i16 k) (value.i16 x)))
      (icmp_ne.i1 (value.i16 x) (iconst.i16 k))
      (spec (= (ite (not (= k x)) 1 0) (result))))

(rule (simplify (icmp_ne.i1 (iconst.i32 k) (value.i32 x)))
      (icmp_ne.i1 (value.i32 x) (iconst.i32 k))
      (spec (= (ite (not (= k x)) 1 0) (result))))

(rule (simplify (icmp_ne.i1 (iconst.i64 k) (value.i64 x)))
      (icmp_ne.i1 (value.i64 x) (iconst.i64 k))
      (spec (= (ite (not (= k x)) 1 0) (result))))

(rule (simplify (icmp_slt.i1 (iconst.i8 k) (value.i8 x)))
      (icmp_sgt.i1 (value.i8 x) (iconst.i8 k))
      (spec (= (ite (bvslt k x) 1 0) (result))))

(rule (simplify (icmp_slt.i1 (iconst.i16 k) (value.i16 x)))
      (icmp_sgt.i1 (value.i16 x) (iconst.i16 k))
      (spec (= (ite (bvslt k x) 1 0) (result))))

(rule (simplify (icmp_slt.i1 (iconst.i32 k) (value.i32 x)))
      (icmp_sgt.i1 (value.i32 x) (iconst.i32 k))
      (spec (= (ite (bvslt k x) 1 0) (result))))

(rule (simplify (icmp_slt.i1 (iconst.i64 k) (value.i64 x)))
      (icmp_sgt.i1 (value.i64 x) (iconst.i64 k))
      (spec (= (ite (bvslt k x) 1 0) (result))))

(rule (simplify (icmp_sle.i1 (iconst.i8 k) (value.i8 x)))
      (icmp_sge.i1 (value.i8 x) (iconst.i8 k))
      (spec (= (ite (bvsle k x) 1 0) (result))))

(rule (simplify (icmp_sle.i1 (iconst.i16 k) (value.i16 x)))
      (icmp_sge.i1 (value.i16 x) (iconst.i16 k))
      (spec (= (ite (bvsle k x) 1 0) (result))))

(rule (simplify (icmp_sle.i1 (iconst.i32 k) (value.i32 x)))
      (icmp_sge.i1 (value.i32 x) (iconst.i32 k))
      (spec (= (ite (bvsle k x) 1 0) (result))))

(rule (simplify (icmp_sle.i1 (iconst.i64 k) (value.i64 x)))
