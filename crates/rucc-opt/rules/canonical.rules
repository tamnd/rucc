      (spec (= (ite (bvsge k x) 1 0) (result))))

(rule (simplify (icmp_sge.i1 (iconst.i64 k) (value.i64 x)))
      (icmp_sle.i1 (value.i64 x) (iconst.i64 k))
      (spec (= (ite (bvsge k x) 1 0) (result))))

(rule (simplify (icmp_ult.i1 (iconst.i8 k) (value.i8 x)))
      (icmp_ugt.i1 (value.i8 x) (iconst.i8 k))
      (spec (= (ite (bvult k x) 1 0) (result))))

(rule (simplify (icmp_ult.i1 (iconst.i16 k) (value.i16 x)))
      (icmp_ugt.i1 (value.i16 x) (iconst.i16 k))
