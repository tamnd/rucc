(rule (simplify (icmp_ugt.i1 (value.i8 x) (iconst.i8 -1)))
      (iconst.i1 0)
      (spec (= (ite (bvugt x -1) 1 0) (result))))

(rule (simplify (icmp_ule.i1 (value.i8 x) (iconst.i8 -1)))
      (iconst.i1 1)
      (spec (= (ite (bvule x -1) 1 0) (result))))

