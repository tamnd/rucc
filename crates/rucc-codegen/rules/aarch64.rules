;; A multiply by one more than a power of two is the value added to itself shifted, which is one
;; instruction where the multiply wants the constant in a register first.

(rule (lower (mul.i32 (value.i32 x) (iconst.i32 3)))
      (a64.add_lsl_32 x x 1)
      (spec (= (bvmul x 3) (result))))

(rule (lower (mul.i32 (value.i32 x) (iconst.i32 5)))
      (a64.add_lsl_32 x x 2)
      (spec (= (bvmul x 5) (result))))

(rule (lower (mul.i32 (value.i32 x) (iconst.i32 9)))
      (a64.add_lsl_32 x x 3)
      (spec (= (bvmul x 9) (result))))

(rule (lower (mul.i32 (value.i32 x) (iconst.i32 17)))
      (a64.add_lsl_32 x x 4)
      (spec (= (bvmul x 17) (result))))

(rule (lower (mul.i64 (value.i64 x) (iconst.i64 3)))
      (a64.add_lsl_64 x x 1)
      (spec (= (bvmul x 3) (result))))

(rule (lower (mul.i64 (value.i64 x) (iconst.i64 5)))
      (a64.add_lsl_64 x x 2)
      (spec (= (bvmul x 5) (result))))

(rule (lower (mul.i64 (value.i64 x) (iconst.i64 9)))
      (a64.add_lsl_64 x x 3)
      (spec (= (bvmul x 9) (result))))

(rule (lower (mul.i64 (value.i64 x) (iconst.i64 17)))
      (a64.add_lsl_64 x x 4)
      (spec (= (bvmul x 17) (result))))

;; A field read out of a register, which is a shift right and a mask of ones from the bottom and is
;; one `ubfx`. The instruction's constant is the mask moved up to where the field is.

(rule (lower (and.i32 (lshr.i32 (value.i32 x) (iconst.i32 k)) (iconst.i32 m)))
      (if (and (and (>= k 0) (< k 32))
               (and (> m 0) (and (power_of_two.i32 (+ m 1)) (<= (+ k (ctz.i32 (+ m 1))) 32)))))
      (a64.ubfx_32 x (bvshl m k))
      (spec (= (bvand (bvlshr x k) m) (result))))

(rule (lower (and.i64 (lshr.i64 (value.i64 x) (iconst.i64 k)) (iconst.i64 m)))
      (if (and (and (>= k 0) (< k 64))
               (and (> m 0) (and (power_of_two.i64 (+ m 1)) (<= (+ k (ctz.i64 (+ m 1))) 64)))))
      (a64.ubfx_64 x (bvshl m k))
      (spec (= (bvand (bvlshr x k) m) (result))))

;; A shifted register beside a constant. The rules above would put the constant in a register to
;; get the shift for nothing, which is no shorter, so the shift is its own instruction and the
;; constant goes in the immediate the way it did before.

