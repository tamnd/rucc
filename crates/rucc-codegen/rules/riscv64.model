;; What the terms in the RISC-V rule set mean, in bitvectors.
;;
;; The x86-64 model is the one to read first. This one says the same things about RV64GC and
;; follows the same rules: a machine head is one opcode at one operand size, and every head the
;; rules use has an entry here or in the file this one includes.
;;
;; The entries for the thirty two bit opcodes are about the low word of the registers, and say
;; nothing about the high one. What the high word holds is the promise the top of `riscv64.rules`
;; describes, which is kept by the rules rather than proved here.
(include crates/rucc-ir/rules/ir.model)

;; The machine. Everything from here down is RISC-V and nothing above it is.

;; Loading a constant into a register, which `li` does in as many instructions as it takes.
(semantics (rv.li_32 c) c)
(semantics (rv.li_64 c) c)

;; Arithmetic, at the word with the `w` instructions and at the whole register, and with a
;; constant in place of the second register where the instruction takes one.
(semantics (rv.add_rr_32 l r) (bvadd l r))
(semantics (rv.add_rr_64 l r) (bvadd l r))
(semantics (rv.sub_rr_32 l r) (bvsub l r))
(semantics (rv.sub_rr_64 l r) (bvsub l r))
(semantics (rv.and_rr_32 l r) (bvand l r))
(semantics (rv.and_rr_64 l r) (bvand l r))
(semantics (rv.or_rr_32 l r) (bvor l r))
(semantics (rv.or_rr_64 l r) (bvor l r))
(semantics (rv.xor_rr_32 l r) (bvxor l r))
(semantics (rv.xor_rr_64 l r) (bvxor l r))
(semantics (rv.mul_rr_32 l r) (bvmul l r))
(semantics (rv.mul_rr_64 l r) (bvmul l r))
(semantics (rv.mulhu_rr_64 l r) (extract 127 64 (bvmul (zero_extend 64 128 l) (zero_extend 64 128 r))))
(semantics (rv.mulh_rr_64 l r) (extract 127 64 (bvmul (sign_extend 64 128 l) (sign_extend 64 128 r))))
(semantics (rv.add_ri_32 l r) (bvadd l r))
(semantics (rv.add_ri_64 l r) (bvadd l r))
(semantics (rv.and_ri_32 l r) (bvand l r))
(semantics (rv.and_ri_64 l r) (bvand l r))
(semantics (rv.or_ri_32 l r) (bvor l r))
(semantics (rv.or_ri_64 l r) (bvor l r))
(semantics (rv.xor_ri_32 l r) (bvxor l r))
(semantics (rv.xor_ri_64 l r) (bvxor l r))
(semantics (rv.neg_r_32 v) (bvsub 0 v))
(semantics (rv.neg_r_64 v) (bvsub 0 v))
(semantics (rv.not_r_32 v) (bvnot v))
(semantics (rv.not_r_64 v) (bvnot v))

;; Division. The machine gives back an answer for a divisor of zero where the IR has no such
;; division at all, so the entries say what the two agree on and nothing about the case
;; neither side reaches.
(semantics (rv.div_rr_32 l r) (bvsdiv l r))
(semantics (rv.div_rr_64 l r) (bvsdiv l r))
(semantics (rv.divu_rr_32 l r) (bvudiv l r))
(semantics (rv.divu_rr_64 l r) (bvudiv l r))
(semantics (rv.rem_rr_32 l r) (bvsrem l r))
(semantics (rv.rem_rr_64 l r) (bvsrem l r))
(semantics (rv.remu_rr_32 l r) (bvurem l r))
(semantics (rv.remu_rr_64 l r) (bvurem l r))

;; Shifts. By a constant the count is whatever the rule's guard let through, and by a register
;; the machine takes it modulo the size it shifts at. A byte or a half shifted right is moved to
;; the top of the register first, and so is the shift at its own width.
(semantics (rv.sll_ri_32 l r) (bvshl l r))
(semantics (rv.sll_ri_64 l r) (bvshl l r))
(semantics (rv.srl_ri_32 l r) (bvlshr l r))
(semantics (rv.srl_ri_64 l r) (bvlshr l r))
(semantics (rv.sra_ri_32 l r) (bvashr l r))
(semantics (rv.sra_ri_64 l r) (bvashr l r))
(semantics (rv.srl_ri_8 l r) (bvlshr l r))
(semantics (rv.srl_ri_16 l r) (bvlshr l r))
(semantics (rv.sra_ri_8 l r) (bvashr l r))
(semantics (rv.sra_ri_16 l r) (bvashr l r))
(semantics (rv.sll_rr_32 l r) (bvshl l (bvand r 31)))
(semantics (rv.sll_rr_64 l r) (bvshl l (bvand r 63)))
(semantics (rv.srl_rr_32 l r) (bvlshr l (bvand r 31)))
(semantics (rv.srl_rr_64 l r) (bvlshr l (bvand r 63)))
(semantics (rv.sra_rr_32 l r) (bvashr l (bvand r 31)))
(semantics (rv.sra_rr_64 l r) (bvashr l (bvand r 63)))

;; A comparison and what turns it into a zero or a one, as one term. The names are the AArch64
;; condition codes: `lo`, `ls`, `hi` and `hs` are the unsigned ones.
(semantics (rv.cmp_set_eq_32 l r) (ite (= l r) 1 0))
(semantics (rv.cmp_set_ne_32 l r) (ite (not (= l r)) 1 0))
(semantics (rv.cmp_set_lt_32 l r) (ite (bvslt l r) 1 0))
(semantics (rv.cmp_set_le_32 l r) (ite (bvsle l r) 1 0))
(semantics (rv.cmp_set_gt_32 l r) (ite (bvsgt l r) 1 0))
(semantics (rv.cmp_set_ge_32 l r) (ite (bvsge l r) 1 0))
(semantics (rv.cmp_set_lo_32 l r) (ite (bvult l r) 1 0))
(semantics (rv.cmp_set_ls_32 l r) (ite (bvule l r) 1 0))
(semantics (rv.cmp_set_hi_32 l r) (ite (bvugt l r) 1 0))
(semantics (rv.cmp_set_hs_32 l r) (ite (bvuge l r) 1 0))
(semantics (rv.cmp_set_eq_64 l r) (ite (= l r) 1 0))
(semantics (rv.cmp_set_ne_64 l r) (ite (not (= l r)) 1 0))
(semantics (rv.cmp_set_lt_64 l r) (ite (bvslt l r) 1 0))
(semantics (rv.cmp_set_le_64 l r) (ite (bvsle l r) 1 0))
(semantics (rv.cmp_set_gt_64 l r) (ite (bvsgt l r) 1 0))
(semantics (rv.cmp_set_ge_64 l r) (ite (bvsge l r) 1 0))
(semantics (rv.cmp_set_lo_64 l r) (ite (bvult l r) 1 0))
(semantics (rv.cmp_set_ls_64 l r) (ite (bvule l r) 1 0))
(semantics (rv.cmp_set_hi_64 l r) (ite (bvugt l r) 1 0))
(semantics (rv.cmp_set_hs_64 l r) (ite (bvuge l r) 1 0))

;; A copy of the second operand, a `bnez` on the condition over a copy of the first.
(semantics (rv.sel_32 f t c) (ite (not (= c 0)) t f))
(semantics (rv.sel_64 f t c) (ite (not (= c 0)) t f))

;; Widening, as a shift up and a shift back down, an `andi` with 255 or a `sext.w`.
(semantics (rv.sextb_16 v) (sign_extend 8 16 v))
(semantics (rv.sextb_32 v) (sign_extend 8 32 v))
(semantics (rv.sextb_64 v) (sign_extend 8 64 v))
(semantics (rv.sexth_32 v) (sign_extend 16 32 v))
(semantics (rv.sexth_64 v) (sign_extend 16 64 v))
(semantics (rv.sextw_64 v) (sign_extend 32 64 v))
(semantics (rv.zextb_16 v) (zero_extend 8 16 v))
(semantics (rv.zextb_32 v) (zero_extend 8 32 v))
(semantics (rv.zextb_64 v) (zero_extend 8 64 v))
(semantics (rv.zexth_32 v) (zero_extend 16 32 v))
(semantics (rv.zexth_64 v) (zero_extend 16 64 v))
(semantics (rv.zextw_64 v) (zero_extend 32 64 v))

;; Widening one bit is an `andi` with one, which keeps the bit and clears the rest, so it does not
;; matter what was above the bit in the register it came from.
(semantics (rv.bit_to_8 v) (zero_extend 1 8 v))
(semantics (rv.bit_to_16 v) (zero_extend 1 16 v))
(semantics (rv.bit_to_32 v) (zero_extend 1 32 v))
(semantics (rv.bit_to_64 v) (zero_extend 1 64 v))

;; Narrowing, which is a copy for a byte or a half and `sext.w` for a word. Narrowing to one bit
;; is an `andi` that keeps the bit and clears the rest.
(semantics (rv.low_8 v) (extract 7 0 v))
(semantics (rv.low_16 v) (extract 15 0 v))
(semantics (rv.low_32 v) (extract 31 0 v))
(semantics (rv.bit_of_32 l r) (bvand (extract 0 0 l) r))
(semantics (rv.bit_of_64 l r) (bvand (extract 0 0 l) r))

;; The two addressing modes a load and a store reach through, which are an addition and nothing
;; about memory.
(semantics (amode_base base) base)
(semantics (amode_base_offset base offset) (bvadd base offset))

;; Reading memory, on the IR side. A load and a store are about which end of a value sits at the
;; lowest address, which is a fact about the target. RISC-V is little endian, so these are the
;; x86-64 entries.
(semantics (load.i1 a)
           (extract 0 0 (select (mem) a)))
(semantics (load.i8 a)
           (select (mem) a))
(semantics (load.i16 a)
           (concat (select (mem) (bvadd a 1)) (select (mem) a)))
(semantics (load.i32 a)
           (concat (select (mem) (bvadd a 3)) (select (mem) (bvadd a 2))
                       (select (mem) (bvadd a 1)) (select (mem) a)))
(semantics (load.i64 a)
           (concat (select (mem) (bvadd a 7)) (select (mem) (bvadd a 6))
                       (select (mem) (bvadd a 5)) (select (mem) (bvadd a 4))
                       (select (mem) (bvadd a 3)) (select (mem) (bvadd a 2))
                       (select (mem) (bvadd a 1)) (select (mem) a)))
(semantics (load.f32 a)
           (float_from_bits 32 (concat (select (mem) (bvadd a 3)) (select (mem) (bvadd a 2))
                       (select (mem) (bvadd a 1)) (select (mem) a))))
(semantics (load.f64 a)
           (float_from_bits 64 (concat (select (mem) (bvadd a 7)) (select (mem) (bvadd a 6))
                       (select (mem) (bvadd a 5)) (select (mem) (bvadd a 4))
                       (select (mem) (bvadd a 3)) (select (mem) (bvadd a 2))
                       (select (mem) (bvadd a 1)) (select (mem) a))))

;; Writing memory, on the IR side.
(semantics (store.i1 v a)
           (store (mem) a (zero_extend 1 8 v)))
(semantics (store.i8 v a)
           (store (mem) a v))
(semantics (store.i16 v a)
           (store (store (mem)
                       a (extract 7 0 v))
                       (bvadd a 1) (extract 15 8 v)))
(semantics (store.i32 v a)
           (store (store (store (store (mem)
                       a (extract 7 0 v))
                       (bvadd a 1) (extract 15 8 v))
                       (bvadd a 2) (extract 23 16 v))
                       (bvadd a 3) (extract 31 24 v)))
(semantics (store.i64 v a)
           (store (store (store (store (store (store (store (store (mem)
                       a (extract 7 0 v))
                       (bvadd a 1) (extract 15 8 v))
                       (bvadd a 2) (extract 23 16 v))
                       (bvadd a 3) (extract 31 24 v))
                       (bvadd a 4) (extract 39 32 v))
                       (bvadd a 5) (extract 47 40 v))
                       (bvadd a 6) (extract 55 48 v))
                       (bvadd a 7) (extract 63 56 v)))
(semantics (store.f32 v a)
           (store (store (store (store (mem)
                       a (extract 7 0 (bits_from_float 32 v)))
                       (bvadd a 1) (extract 15 8 (bits_from_float 32 v)))
                       (bvadd a 2) (extract 23 16 (bits_from_float 32 v)))
                       (bvadd a 3) (extract 31 24 (bits_from_float 32 v))))
(semantics (store.f64 v a)
           (store (store (store (store (store (store (store (store (mem)
                       a (extract 7 0 (bits_from_float 64 v)))
                       (bvadd a 1) (extract 15 8 (bits_from_float 64 v)))
                       (bvadd a 2) (extract 23 16 (bits_from_float 64 v)))
                       (bvadd a 3) (extract 31 24 (bits_from_float 64 v)))
                       (bvadd a 4) (extract 39 32 (bits_from_float 64 v)))
                       (bvadd a 5) (extract 47 40 (bits_from_float 64 v)))
                       (bvadd a 6) (extract 55 48 (bits_from_float 64 v)))
                       (bvadd a 7) (extract 63 56 (bits_from_float 64 v))))

;; The instructions that do it, written out again rather than in terms of the IR heads above, so
;; that the two halves of a rule are two statements.
(semantics (rv.ld_bit a)
           (extract 0 0 (select (mem) a)))
(semantics (rv.ld_8 a)
           (select (mem) a))
(semantics (rv.ld_16 a)
           (concat (select (mem) (bvadd a 1)) (select (mem) a)))
(semantics (rv.ld_32 a)
           (concat (select (mem) (bvadd a 3)) (select (mem) (bvadd a 2))
                       (select (mem) (bvadd a 1)) (select (mem) a)))
(semantics (rv.ld_64 a)
           (concat (select (mem) (bvadd a 7)) (select (mem) (bvadd a 6))
                       (select (mem) (bvadd a 5)) (select (mem) (bvadd a 4))
                       (select (mem) (bvadd a 3)) (select (mem) (bvadd a 2))
                       (select (mem) (bvadd a 1)) (select (mem) a)))
(semantics (rv.ld_f32 a)
           (float_from_bits 32 (concat (select (mem) (bvadd a 3)) (select (mem) (bvadd a 2))
                       (select (mem) (bvadd a 1)) (select (mem) a))))
(semantics (rv.ld_f64 a)
           (float_from_bits 64 (concat (select (mem) (bvadd a 7)) (select (mem) (bvadd a 6))
                       (select (mem) (bvadd a 5)) (select (mem) (bvadd a 4))
                       (select (mem) (bvadd a 3)) (select (mem) (bvadd a 2))
                       (select (mem) (bvadd a 1)) (select (mem) a))))
(semantics (rv.st_bit a v)
           (store (mem) a (zero_extend 1 8 v)))
(semantics (rv.st_8 a v)
           (store (mem) a v))
(semantics (rv.st_16 a v)
           (store (store (mem)
                       a (extract 7 0 v))
                       (bvadd a 1) (extract 15 8 v)))
(semantics (rv.st_32 a v)
           (store (store (store (store (mem)
                       a (extract 7 0 v))
                       (bvadd a 1) (extract 15 8 v))
                       (bvadd a 2) (extract 23 16 v))
                       (bvadd a 3) (extract 31 24 v)))
(semantics (rv.st_64 a v)
           (store (store (store (store (store (store (store (store (mem)
                       a (extract 7 0 v))
                       (bvadd a 1) (extract 15 8 v))
                       (bvadd a 2) (extract 23 16 v))
                       (bvadd a 3) (extract 31 24 v))
                       (bvadd a 4) (extract 39 32 v))
                       (bvadd a 5) (extract 47 40 v))
                       (bvadd a 6) (extract 55 48 v))
                       (bvadd a 7) (extract 63 56 v)))
(semantics (rv.st_f32 a v)
           (store (store (store (store (mem)
                       a (extract 7 0 (bits_from_float 32 v)))
                       (bvadd a 1) (extract 15 8 (bits_from_float 32 v)))
                       (bvadd a 2) (extract 23 16 (bits_from_float 32 v)))
                       (bvadd a 3) (extract 31 24 (bits_from_float 32 v))))
(semantics (rv.st_f64 a v)
           (store (store (store (store (store (store (store (store (mem)
                       a (extract 7 0 (bits_from_float 64 v)))
                       (bvadd a 1) (extract 15 8 (bits_from_float 64 v)))
                       (bvadd a 2) (extract 23 16 (bits_from_float 64 v)))
                       (bvadd a 3) (extract 31 24 (bits_from_float 64 v)))
                       (bvadd a 4) (extract 39 32 (bits_from_float 64 v)))
                       (bvadd a 5) (extract 47 40 (bits_from_float 64 v)))
                       (bvadd a 6) (extract 55 48 (bits_from_float 64 v)))
                       (bvadd a 7) (extract 63 56 (bits_from_float 64 v))))

;; Giving a value back and branching on one, which compute nothing: the value arrives unchanged
;; in the register the convention names, and `rucc_target::riscv64` says which register that is.
(semantics (rv.ret_val_32 v) v)
(semantics (rv.ret_val_64 v) v)
(semantics (rv.ret_val_f32 v) v)
(semantics (rv.ret_val_f64 v) v)
(semantics (rv.br_cond_32 v) v)

;; Floats, one entry per instruction and format.
(semantics (rv.fadd_f32 l r) (fp.add l r))
(semantics (rv.fadd_f64 l r) (fp.add l r))
(semantics (rv.fsub_f32 l r) (fp.sub l r))
(semantics (rv.fsub_f64 l r) (fp.sub l r))
(semantics (rv.fmul_f32 l r) (fp.mul l r))
(semantics (rv.fmul_f64 l r) (fp.mul l r))
(semantics (rv.fdiv_f32 l r) (fp.div l r))
(semantics (rv.fdiv_f64 l r) (fp.div l r))
(semantics (rv.fmadd_f32 a b c) (fp.fma a b c))
(semantics (rv.fmadd_f64 a b c) (fp.fma a b c))

;; A float comparison, which writes a zero or a one. The unordered ones are the ordered ones
;; turned over, which is what the second instruction does.
(semantics (rv.fcmp_set_gt_f32 l r) (ite (fp.gt l r) 1 0))
(semantics (rv.fcmp_set_ge_f32 l r) (ite (fp.geq l r) 1 0))
(semantics (rv.fcmp_set_lt_f32 l r) (ite (fp.lt l r) 1 0))
(semantics (rv.fcmp_set_le_f32 l r) (ite (fp.leq l r) 1 0))
(semantics (rv.fcmp_set_eq_f32 l r) (ite (fp.eq l r) 1 0))
(semantics (rv.fcmp_set_ne_f32 l r) (ite (not (fp.eq l r)) 1 0))
(semantics (rv.fcmp_set_ult_f32 l r) (ite (not (fp.geq l r)) 1 0))
(semantics (rv.fcmp_set_ule_f32 l r) (ite (not (fp.gt l r)) 1 0))
(semantics (rv.fcmp_set_ugt_f32 l r) (ite (not (fp.leq l r)) 1 0))
(semantics (rv.fcmp_set_uge_f32 l r) (ite (not (fp.lt l r)) 1 0))
(semantics (rv.fcmp_set_gt_f64 l r) (ite (fp.gt l r) 1 0))
(semantics (rv.fcmp_set_ge_f64 l r) (ite (fp.geq l r) 1 0))
(semantics (rv.fcmp_set_lt_f64 l r) (ite (fp.lt l r) 1 0))
(semantics (rv.fcmp_set_le_f64 l r) (ite (fp.leq l r) 1 0))
(semantics (rv.fcmp_set_eq_f64 l r) (ite (fp.eq l r) 1 0))
(semantics (rv.fcmp_set_ne_f64 l r) (ite (not (fp.eq l r)) 1 0))
(semantics (rv.fcmp_set_ult_f64 l r) (ite (not (fp.geq l r)) 1 0))
(semantics (rv.fcmp_set_ule_f64 l r) (ite (not (fp.gt l r)) 1 0))
(semantics (rv.fcmp_set_ugt_f64 l r) (ite (not (fp.leq l r)) 1 0))
(semantics (rv.fcmp_set_uge_f64 l r) (ite (not (fp.lt l r)) 1 0))

;; Conversions. `fcvt_f32_f64` widens a float to a double and `fcvt_f64_f32` narrows the other
;; way, `fcvtzs` rounds toward zero into a signed integer, `scvtf` goes back, and the `fmv`
;; pairs move the bits between the register files without looking at them.
(semantics (rv.fcvt_f32_f64 v) (float_from_float 32 64 v))
(semantics (rv.fcvt_f64_f32 v) (float_from_float 64 32 v))
(semantics (rv.fcvtzs_f32_32 v) (signed_from_float 32 32 v))
(semantics (rv.fcvtzs_f32_64 v) (signed_from_float 32 64 v))
(semantics (rv.fcvtzs_f64_32 v) (signed_from_float 64 32 v))
(semantics (rv.fcvtzs_f64_64 v) (signed_from_float 64 64 v))
(semantics (rv.scvtf_32_f32 v) (float_from_signed 32 32 v))
(semantics (rv.scvtf_32_f64 v) (float_from_signed 32 64 v))
(semantics (rv.scvtf_64_f32 v) (float_from_signed 64 32 v))
(semantics (rv.scvtf_64_f64 v) (float_from_signed 64 64 v))
(semantics (rv.fmov_to_f32 v) (float_from_bits 32 v))
(semantics (rv.fmov_from_f32 v) (bits_from_float 32 v))
(semantics (rv.fmov_to_f64 v) (float_from_bits 64 v))
(semantics (rv.fmov_from_f64 v) (bits_from_float 64 v))
