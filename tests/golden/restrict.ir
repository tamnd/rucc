block2:
    %7 = iconst.i64 4
    %8 = mul.nsw %5, %7
    %9 = ptr_add %0, %8
    %10 = iconst.i64 4
    %11 = mul.nsw %5, %10
    %12 = ptr_add %0, %11
    %13 = load.i32 %12, align 4, tbaa !1, restrict(3, 1)
    %14 = iconst.i64 4
    %15 = mul.nsw %5, %14
    %16 = ptr_add %1, %15
    %17 = load.i32 %16, align 4, tbaa !1, restrict(3, 2)
    %18 = mul.nsw %13, %17
    store %18 -> %9, align 4, tbaa !1, restrict(3, 1)
    %19 = iconst.i64 1
    %20 = add %5, %19
    jump block1(%20)

block3:
    return
}

func @indirect(ptr, ptr), linkage(external) {
block0(%0: ptr, %1: ptr):
    %2 = load %0, align 8, tbaa !2, restrict(4, 1)
    %3 = load.i32 %1, align 4, tbaa !1, restrict(4, 2)
    store %3 -> %2, align 4, tbaa !1
    return
}

func @plain(ptr, ptr), linkage(external) {
block0(%0: ptr, %1: ptr):
    %2 = load.i32 %1, align 4, tbaa !1
    store %2 -> %0, align 4, tbaa !1
    return
}

!0 = tbaa "char", offset 0
!1 = tbaa "int", parent !0, offset 0
!2 = tbaa "pointer", parent !0, offset 0
