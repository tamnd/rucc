block1:
    %1 = iconst.i32 1
    %2 = add.nsw %3, %1
    jump block2(%2)

block2(%3: i32):
    %4 = iconst.i32 1
    %5 = icmp eq %3, %4
    br_if %5, block1, block3

block3:
    return %3
}

func @present() -> i32, linkage(external) {
block0:
    %0 = global_addr @maybe_there
    %1 = iconst.i64 0
    %2 = inttoptr.ptr %1
    %3 = icmp ne %0, %2
