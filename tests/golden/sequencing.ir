; ModuleID = 'tests/golden/sequencing.c'
; format 0
target triple = "x86_64-unknown-linux-gnu"
target datalayout = "e-p:64:64-i64:64-f80:128-S128"

global @x : bytes 4 = { zero 4 }, align 4, linkage(external)

func @side() -> i32, linkage(external);

func @compound_reads_after_the_right_side(), linkage(external) {
block0:
    %0 = global_addr @x
    %1 = iconst.i32 0
    %2 = sext.i64 %1
    %3 = iconst.i64 4
    %4 = mul.nsw %2, %3
    %5 = ptr_add %0, %4
    %6 = call @side() : () -> i32
    %7 = load.i32 %5, align 4
    %8 = or %7, %6
    store %8 -> %5, align 4
    return
}

func @compound_on_a_pointer_reads_after_the_right_side(ptr), linkage(external) {
block0(%0: ptr):
    %1 = call @side() : () -> i32
    %2 = load %0, align 8
    %3 = sext.i64 %1
    %4 = iconst.i64 4
    %5 = mul.nsw %3, %4
    %6 = ptr_add %2, %5
    store %6 -> %0, align 8
    return
}

func @postfix() -> i32, linkage(external) {
block0:
    %0 = global_addr @x
    %1 = iconst.i32 0
    %2 = sext.i64 %1
    %3 = iconst.i64 4
    %4 = mul.nsw %2, %3
    %5 = ptr_add %0, %4
    %6 = load.i32 %5, align 4
    %7 = iconst.i32 1
    %8 = add %6, %7
    store %8 -> %5, align 4
    return %6
}

func @prefix() -> i32, linkage(external) {
block0:
    %0 = global_addr @x
    %1 = iconst.i32 0
    %2 = sext.i64 %1
    %3 = iconst.i64 4
    %4 = mul.nsw %2, %3
    %5 = ptr_add %0, %4
    %6 = load.i32 %5, align 4
    %7 = iconst.i32 1
    %8 = add %6, %7
    store %8 -> %5, align 4
    return %8
}
